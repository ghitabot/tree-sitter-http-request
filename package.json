{
  "name": "tree-sitter-http-request",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for JetBrains-compatible .http files",
  "main": "bindings/node",
  "keywords": ["parser", "http", "tree-sitter"],
  "license": "0BSD",
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  },
  "tree-sitter": [
    {
      "scope": "source.http",
      "file-types": ["http", "rest"],
      "highlights": "queries/highlights.scm"
    }
  ]
}
